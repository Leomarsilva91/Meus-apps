rules_version = '2';
// Regras do banco de dados dos apps (Firebase > Firestore > Regras).
service cloud.firestore {
  match /databases/{database}/documents {
    function entrou() { return request.auth != null; }
    function adm() { return entrou() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)); }

    // Administradores: o aparelho se cadastra sozinho digitando a chave guardada em admkey/main (campo k).
    // A coleção admkey não pode ser lida por ninguém pelo app.
    match /admins/{uid} {
      allow get: if entrou() && request.auth.uid == uid;
      allow create, update: if entrou() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['k', 'at'])
        && request.resource.data.k is string
        && exists(/databases/$(database)/documents/admkey/main)
        && request.resource.data.k == string(get(/databases/$(database)/documents/admkey/main).data.k);
    }

    // Dados pessoais de cada pessoa: só ela lê e grava.
    match /apps/{app}/data/users/{uid}/{doc=**} {
      allow read, write: if entrou() && request.auth.uid == uid;
    }
    // Cofrinho compartilhado (Prumo): só quem tem o link abre; só a família muda.
    match /apps/{app}/cofs/{code} {
      allow get: if entrou();
      allow create: if entrou() && request.resource.data.owner == request.auth.uid;
      allow update, delete: if entrou() && resource.data.owner == request.auth.uid;
      match /ajuda/{hid} {
        allow create: if entrou() && request.resource.data.uid == request.auth.uid
          && request.resource.data.v is number && request.resource.data.v > 0 && request.resource.data.v <= 100000
          && request.resource.data.nome is string && request.resource.data.nome.size() <= 40
          && request.resource.data.msg is string && request.resource.data.msg.size() <= 200;
        allow read, update, delete: if entrou() && get(/databases/$(database)/documents/apps/$(app)/cofs/$(code)).data.owner == request.auth.uid;
      }
    }
    // Endereço de entrega da compra compartilhada: só quem pediu e o vizinho liberado leem.
    match /apps/{app}/cce/{id} {
      allow read: if entrou() && (resource.data.ow == request.auth.uid || resource.data.para == request.auth.uid || adm());
      allow create, update: if entrou() && request.resource.data.ow == request.auth.uid
        && id == request.auth.uid + '_' + request.resource.data.oid
        && request.resource.data.end is string && request.resource.data.end.size() <= 160
        && (!('rx' in request.resource.data) || (request.resource.data.rx is string && request.resource.data.rx.size() <= 200000))
        && (resource == null || resource.data.ow == request.auth.uid);
      allow delete: if entrou() && resource.data.ow == request.auth.uid;
    }
    // Comprovante de pagamento de meta compartilhada (Prumo): só quem enviou e o dono da meta veem.
    match /apps/{app}/mscp/{id} {
      allow read: if entrou() && (resource.data.ow == request.auth.uid || resource.data.para == request.auth.uid || adm());
      allow create: if entrou() && (request.resource.data.ow == request.auth.uid || adm())
        && id == request.resource.data.ow + '_' + request.resource.data.pid
        && request.resource.data.img is string && request.resource.data.img.size() <= 200000;
      allow delete: if entrou() && resource.data.ow == request.auth.uid;
    }
    // Contratos e reservas da meta de viagem (Prumo): o dono e quem entrou no grupo da meta leem.
    match /apps/{app}/msct/{id} {
      allow read: if entrou() && (resource.data.ow == request.auth.uid || adm()
        || (resource.data.code is string && resource.data.code != ''
            && exists(/databases/$(database)/documents/apps/$(app)/mshj/$(request.auth.uid))
            && resource.data.code in get(/databases/$(database)/documents/apps/$(app)/mshj/$(request.auth.uid)).data.codes));
      allow create, update: if entrou() && request.resource.data.ow == request.auth.uid
        && id == request.auth.uid + '_' + request.resource.data.cid
        && request.resource.data.file is string && request.resource.data.file.size() <= 900000;
      allow delete: if entrou() && resource.data.ow == request.auth.uid;
    }
    // Tasko (versão de teste): pedidos, propostas, conversas e agenda compartilhados entre os aparelhos.
    match /apps/{app}/{col}/{id} {
      allow read, write: if entrou() && col.matches('sync_ms_.*');
    }
    // Áreas que só o administrador lê por inteiro (cada pessoa vê só o seu).
    match /apps/{app}/{col}/{uid} {
      allow read: if entrou() && (
        !(col in ['resg', 'interesse', 'contato', 'vis', 'mlj', 'sub', 'fb', 'adq', 'pts', 'cofs', 'ccs', 'ugr', 'cce', 'cpr', 'mscp', 'pofr', 'msct']) || request.auth.uid == uid || adm());
      allow write: if entrou() && (
        (!(col in ['config', 'comx', 'pts', 'offers', 'pub', 'news', 'stores', 'ph', 'tips', 'ads']) && request.auth.uid == uid) || adm());
    }
  }
}
